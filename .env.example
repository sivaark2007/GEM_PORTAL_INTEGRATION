# =============================================================================
# GeM Portal Integration — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit the actual .env file to Git!
# =============================================================================

# ── Gemini AI API Key (REQUIRED) ──────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── App URL (optional — for self-referential links) ───────────────────────────
APP_URL=http://localhost:5000

# ── Service URLs (auto-wired by Docker Compose — do NOT change) ───────────────
# These are used by the Express server to talk to the Python services.
# When running with Docker Compose, Docker's internal DNS handles routing.
MOCK_GOV_API_URL=http://mock-api:9000
PYTHON_DOC_SERVICE_URL=http://document-service:8000/parse-document

# ── PostgreSQL (auto-wired by Docker Compose — do NOT change) ─────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=gem_portal
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/gem_portal
