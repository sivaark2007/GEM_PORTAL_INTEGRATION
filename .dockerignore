# ── Node.js ───────────────────────────────────────────────────────────────────
node_modules/
dist/
.npm

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# ── SQLite (do not bake local DB into image) ──────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Environment files (never bake secrets into images!) ───────────────────────
.env
.env.local
.env.*.local

# ── OS & editor files ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.git/
.gitignore

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Bun lockfile (not needed in Docker) ───────────────────────────────────────
bun.lock

# ── PDFs and uploads (don't bake into image) ──────────────────────────────────
*.pdf
uploads/
